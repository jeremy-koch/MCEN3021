# ── Quarto / site build artifacts ───────────────────────────────────
# Everything here is regenerated by `quarto render` / `quarto preview`;
# none of it should be committed.
/_site/
/.quarto/
*_files/
site_libs/

# fluidtools_bundle.py is also generated -- _quarto.yml's pre-render hook
# runs scripts/make_bundle.py automatically before every render AND
# preview, so it's always fresh from src/fluidtools/*.py. Committing it
# would risk drift (edit src/, forget to rebuild, stale bundle ships).
fluidtools_bundle.py

